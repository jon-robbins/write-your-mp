{
  "name": "write-your-mp",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "build": "npm run validate:letters && vite build",
    "start": "node server/start.mjs",
    "demo": "npm run build && node server/start.mjs --demo",
    "dev": "vite",
    "dev:api": "node --watch server/start.mjs --demo",
    "validate:letters": "node scripts/validate-letters.mjs",
    "validate:release": "node scripts/validate-letters.mjs --release",
    "test": "node --test tests/*.test.mjs && vitest run --passWithNoTests",
    "test:generator": "uv run --with openai python -m unittest discover -s tests -p 'test_*.py'",
    "screenshots": "npm run build && node scripts/screenshots.mjs"
  },
  "dependencies": {
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^29.1.1",
    "playwright-core": "^1.63.0",
    "supertest": "^7.2.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^4.1.11"
  },
  "description": "Find your MP by postal code and send them an editable, pre-written advocacy letter.",
  "license": "MIT"
}
